{
  "name": "resender",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram forwarding SaaS — copies messages from channels where saving/forwarding is restricted, using each user's own connected account.",
  "type": "commonjs",
  "main": "dist/src/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "start": "node dist/src/main.js",
    "start:worker": "node dist/src/worker.js",
    "dev": "nodemon --exec \"ts-node\" src/main.ts",
    "dev:worker": "nodemon --exec \"ts-node\" src/worker.ts",
    "lint": "eslint \"{src,shared}/**/*.ts\"",
    "lint:fix": "eslint \"{src,shared}/**/*.ts\" --fix",
    "format": "prettier --write \"{src,shared}/**/*.ts\"",
    "db:create": "sequelize-cli db:create",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "migration:create": "sequelize-cli migration:generate --name",
    "seed": "sequelize-cli db:seed:all"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "grammy": "^1.30.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "sequelize": "^6.37.5",
    "telegram": "^2.26.22",
    "uuid": "^11.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "nodemon": "^3.1.9",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "sequelize-cli": "^6.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
