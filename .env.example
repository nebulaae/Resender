# ───────────────────────── App ─────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
LOG_PRETTY=true

# ─────────────────────── Database ──────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=resender
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MAX=10
DB_SYNC_ON_START=true

# ──────────────────────── Secrets ──────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
SESSION_ENC_KEY=

# ─────────────────────── Telegram ──────────────────────
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
BOT_TOKEN=
# BOT_API_ROOT=http://127.0.0.1:8081
